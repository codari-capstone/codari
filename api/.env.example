# 가짜 값이다. 실제 값은 저장소에 넣지 않는다.
DB_URL=jdbc:postgresql://localhost:5432/codingmon
DB_USERNAME=codingmon
DB_PASSWORD=change-me
# HS256 서명 키. openssl rand -base64 32 로 만든다.
JWT_SECRET=change-me-base64-32-bytes-or-more
# 로컬 전용: SMTP가 없을 때 인증번호를 메일 대신 서버 로그에 남긴다. 운영에서는 넣지 않는다.
MAIL_LOG_CODES=true
# 인증번호 메일 SMTP. 넣으면 MAIL_LOG_CODES와 관계없이 실제 메일을 보낸다.
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=change-me
# SPRING_MAIL_PASSWORD=change-me
# MAIL_FROM=no-reply@example.com
# GitHub OAuth App. 콜백 URL은 <API 주소>/api/auth/github/callback 로 등록한다. 주석으로 두면 GitHub 로그인이 웹의 로그인 실패 화면으로 가고 서버 로그에 경고가 남는다.
# GITHUB_CLIENT_ID=change-me
# GITHUB_CLIENT_SECRET=change-me
# GitHub 로그인을 마치고 돌아갈 웹 주소
WEB_BASE_URL=http://localhost:5173
# 채점 서버(Judge0). 주석으로 두면 채점하지 않고 제출이 QUEUED로 남는다. 토큰은 judge/.env의 AUTHN_TOKEN
# JUDGE0_URL=http://127.0.0.1:2358
# JUDGE0_AUTHN_TOKEN=change-me
