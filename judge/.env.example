# 채점 VM 전용 비밀값. 이 파일을 judge/.env로 복사해 값을 바꾼다: cp .env.example .env && chmod 600 .env
# .env는 저장소에 올리지 않는다(루트 .gitignore). 운영 값은 SSM Parameter Store에 보관한다.
# 값은 따옴표 없이, $ # " 가 없는 문자로 만든다. 예: openssl rand -hex 24

# Judge0 내부 Redis·PostgreSQL 비밀번호 (서비스 DB와 무관)
REDIS_PASSWORD=change-me-redis
POSTGRES_PASSWORD=change-me-postgres

# API 서버가 X-Auth-Token 헤더로 보내는 인증 토큰
AUTHN_TOKEN=change-me-authn
# 제출 삭제·목록 조회에 쓰는 X-Auth-User 토큰
AUTHZ_TOKEN=change-me-authz

# 2358을 게시할 호스트 주소. 개발(SSH·SSM 터널)은 127.0.0.1, 운영(API 서버가 있을 때)은 채점 VM 사설 IP
# 사설 IP로 두면 보안 그룹이 유일한 차단이다. EC2는 공인 IP로 온 연결을 사설 IP로 넘긴다(judge/README.md 채점 VM 준비 3번)
JUDGE0_BIND_ADDR=127.0.0.1
