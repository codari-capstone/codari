    {
      "id": "rec_ok_cpp",
      "group": "recursion",
      "file": "rec_ok.cpp",
      "expect": {
        "status": [
          3
        ],
        "stdout_has": [
          "1000000"
        ]
      },
      "note": "깊이 10^6 재귀(DFS 규모)가 스택 제한 안에서 통과해야 함"
    },
    {
      "id": "ole_stdout_py",
      "group": "output",
      "file": "ole_stdout.py",
      "expect": {
        "status": [
          11
        ],
        "exit_code": [
          1
        ],
        "stderr_has": [
          "File too large"
