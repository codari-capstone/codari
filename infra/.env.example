# infra/compose.yaml 비밀값·설정. 이 파일을 infra/.env로 복사해 값을 바꾼다: cp .env.example .env && chmod 600 .env
# .env는 저장소에 올리지 않는다(루트 .gitignore). 값은 따옴표 없이 넣는다.

# 띄울 이미지 태그 (codingmon-api:<TAG>, codingmon-web:<TAG>)
TAG=latest

# 서비스 DB 비밀번호. openssl rand -hex 24
DB_PASSWORD=change-me
# HS256 서명 키. openssl rand -base64 32
JWT_SECRET=change-me-base64-32-bytes-or-more

# 사용자가 접속하는 웹 주소. GitHub 로그인을 마치고 이 주소로 돌아간다
WEB_BASE_URL=https://example.com

# 웹 포트를 게시할 주소. 같은 서버의 HTTPS 프록시만 붙으면 127.0.0.1, 내부망에서 바로 붙으면 0.0.0.0
WEB_BIND_ADDR=127.0.0.1
WEB_PORT=80

# 인증번호 메일 SMTP. 없으면 MAIL_LOG_CODES=true로 인증번호를 API 로그에 남긴다(테스트 서버에서만)
MAIL_LOG_CODES=true
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=change-me
# SPRING_MAIL_PASSWORD=change-me
# MAIL_FROM=no-reply@example.com

# GitHub OAuth App. 콜백 URL은 <WEB_BASE_URL>/api/auth/github/callback. 비워 두면 GitHub 로그인이 웹의 로그인 실패 화면으로 가고 API 로그에 경고
# GITHUB_CLIENT_ID=change-me
# GITHUB_CLIENT_SECRET=change-me

# Cloudflare Tunnel(--profile tunnel). 대시보드에서 터널을 만들 때 나오는 토큰. 비밀값이다
# TUNNEL_TOKEN=change-me
# auto(QUIC 우선, 안 되면 http2) | quic | http2. TLS를 검사하는 프록시 뒤라면 quic
# TUNNEL_PROTOCOL=auto

# 채점 서버(Judge0, judge/README.md). 토큰은 judge/.env의 AUTHN_TOKEN. 비워 두면 제출이 QUEUED로 남는다
# JUDGE0_URL=http://<채점 VM 사설 IP>:2358
# JUDGE0_AUTHN_TOKEN=change-me

# LLM(OpenAI 호환 API, api/README.md). 비워 두면 AI 기능이 장애로 응답한다
# LLM_URL=http://<모델 서버 사설 IP>:11434
# LLM_MODEL=gemma4:12b
